{"kind":"textbox","id":"sh/i94va1gf","slide":2,"text":"The gap: realistic practice must adapt in real time.","textPreview":"The gap: realistic practice must adapt in real time.","textChars":52,"textLines":1,"bbox":[56,622,820,38]}
