# -------- Supabase (browser client — safe to expose) --------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# -------- Supabase (server-side, required by SSR + server fns) --------
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
# Service role — required for trusted interview/evaluation writes. Server-only;
# NEVER prefix this variable with VITE_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# -------- AI providers (server-side only, NEVER prefix with VITE_) --------
# Primary provider. Get a key at https://console.groq.com
GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_TRANSCRIPTION_MODEL="whisper-large-v3-turbo"

# Optional fallback provider. Get a key at https://openrouter.ai
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# Which provider to try first: "groq" | "openrouter" (default: groq)
# AI_PROVIDER="groq"

# -------- Google Sheets coding question catalog (server-side) --------
GOOGLE_SHEET_ID="1mvlc8EYc3OVVU3X7NKoC0iZJr_45BL_pVxiJec0r94c"
GOOGLE_SHEET_GID="0"
# Local development reads ./credentials.json by default. For deployment, set
# one of the following server-side secrets instead of shipping the JSON file:
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64="base64-encoded-service-account-json"
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# -------- Isolated code runner (server-side) --------
# Candidate code is never executed by the PrepPilot web process.
# Free MVP provider. Piston's public endpoint currently permits 5 requests/second.
CODE_RUNNER_PROVIDER="piston"
CODE_RUNNER_URL="https://emkc.org/api/v2/piston/execute"
# Only required when CODE_RUNNER_PROVIDER points to your own authenticated runner.
CODE_RUNNER_API_KEY=""
